# ---- The Odds API (sharp prices) --------------------------------------------
# Key from https://the-odds-api.com (free tier: 500 credits/month)
ODDS_API_KEY=
# basketball_nba, basketball_ncaab, basketball_wnba, basketball_euroleague
# Sports: groups and/or exact Odds API keys, comma-separated.
#   groups: basketball, soccer (top 8 leagues), soccer_small (~40 lower/mid leagues),
#           soccer_all (every soccer league in season), icehockey, tennis, tabletennis,
#           volleyball, cricket, boxing, handball, rugby, baseball
#   keys:   basketball_nba, basketball_ncaab, basketball_euroleague, soccer_epl, icehockey_nhl, ...
# Run `node bin/ev-bot.js sports` to see what is in season, what Betika has, and the credit cost.
# Each league costs 1 credit per market per scan (soccer/basketball buy 2: h2h + totals).
# MARKETS_SOCCER=h2h  -> soccer leagues buy only 1X2 (1 credit each instead of 2).
SPORTS=basketball_nba,basketball_ncaab,basketball_euroleague,soccer,icehockey,tennis,cricket,boxing,rugby,handball,volleyball,tabletennis,baseball
# Betika's Winner (incl. OT) and Total (incl. OT) are compared with these.
# Each market costs 1 credit per scan.
MARKETS=h2h,totals
REGIONS=eu
SHARP_BOOKS=pinnacle
# Leave empty: with BETIKA_ENABLED the API is only asked for the sharp books
TARGET_BOOKS=

# ---- Edge / staking ---------------------------------------------------------
DEVIG_METHOD=power          # multiplicative | power | additive
MIN_EV=0.03                 # 3% minimum edge, measured AFTER the winnings tax
MIN_DECIMAL_ODDS=1.30
MAX_DECIMAL_ODDS=4.00
MAX_HOURS_TO_START=48       # earlier prices are sometimes softer
MAX_LINE_AGE_SECONDS=600
REALERT_EV_DELTA=0.01
# Basketball alternate totals: Betika's other total lines, priced from Pinnacle's main line
# with the spread measured from Betika's own ladder. Model-based, so a stricter threshold.
ALT_TOTALS=true
ALT_TOTALS_MIN_EV=0.04
ALT_TOTALS_MAX_DISTANCE=6   # only lines within 6 points of Pinnacle's main line

# Basketball team totals ("<Team> Total (incl. OT)"): each team's expected score from Pinnacle's
# total + point spread; buys Pinnacle's spread too (+1 credit per basketball league per scan).
TEAM_TOTALS=true
TEAM_TOTALS_MIN_EV=0.04
TEAM_TOTALS_MAX_DISTANCE=4  # only lines within 4 points of the team's expected score

# Faster scans shortly before tip-off (0 = off). Only leagues with a game in the window are fetched.
# Costs credits: ~2 per league per fast scan while games are about to start.
FAST_SCAN_MINUTES=0         # e.g. 120 = start fast scans 2 hours before a game
FAST_POLL_SECONDS=300       # how often during that window
FAST_SCAN_SPORTS=basketball # sport groups that get fast scans

BANKROLL=10000              # KES
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.02
POLL_SECONDS=32400

# ---- Betika (Puppeteer) -----------------------------------------------------
BETIKA_ENABLED=true
BETIKA_LIVE=false           # false = dry run: fills the slip, never clicks Place Bet
BETIKA_WINNINGS_TAX=0.20    # Kenya withholding tax on net winnings (Finance Act 2026)
BETIKA_PHONE=07XXXXXXXX
BETIKA_PASSWORD=
BETIKA_HEADLESS=true
BETIKA_MIN_STAKE=10         # KES
BETIKA_MAX_STAKE=500        # KES per bet
# BETIKA_FIXED_STAKE=40     # bet exactly this on every bet (overrides Kelly sizing and BETIKA_MAX_STAKE)
BETIKA_DAILY_STAKE_LIMIT=2000
BETIKA_MAX_BETS_PER_DAY=10
# BETIKA_SELECTORS=./my-selectors.json   # override src/betika/selectors.json
# CHROME_PATH=/path/to/chrome            # if Puppeteer's own Chrome isn't installed

STORE_PATH=ev-bot-store.json

# ---- Results -----------------------------------------------------------------
# Grade finished bets from final scores (The Odds API /scores, ~2 credits per sport with
# unsettled bets). Real bets and dry runs are tracked separately on the dashboard.
SETTLE=true
SETTLE_INTERVAL_MINUTES=60
BETIKA_HISTORY=true         # also read Betika's My Bets for placed bets: Betika's status and payout win

# ---- Dashboard ---------------------------------------------------------------
# While the bot runs: open http://localhost:3000 (only reachable from this computer)
DASHBOARD=true
DASHBOARD_PORT=3000
# Dashboard warns when Odds API credits fall below this (critical below a fifth of it)
CREDITS_WARN_BELOW=1000
# To open the dashboard on your phone (same Wi-Fi): DASHBOARD_HOST=0.0.0.0 and a long random
# DASHBOARD_KEY (at least 16 characters). Open http://<PC's IP>:3000/?key=<key> once on the phone;
# it is remembered after that. Without a key the dashboard stays on this PC only.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_KEY=

# ---- In-play (live) betting -------------------------------------------------
# Pinnacle's live prices (The Odds API) vs Betika's live feed, for games under way.
# Needs a paid Odds API plan: ~2 credits per league with a live game, every LIVE_POLL_SECONDS
# (e.g. 3 leagues live, every 45 s = ~480 credits/hour). No credits when nothing is live.
LIVE_BETTING=false          # true = scan games in progress
LIVE_BETS_LIVE=false        # true = place real in-play bets (needs BETIKA_LIVE=true too); else dry run
LIVE_SPORTS=basketball,soccer
LIVE_POLL_SECONDS=45
LIVE_MIN_EV=0.05            # stricter than pre-game: live prices move fast
LIVE_MAX_ODDS_AGE_SECONDS=30  # Pinnacle's live price must be this fresh, or no bet
LIVE_MAX_EV=0.15              # in play, a bigger "edge" is nearly always a stale price after a goal/basket: skipped
LIVE_SCORE_SETTLE_SECONDS=10  # Pinnacle must have priced the game this long AFTER the score last changed
LIVE_CONFIRM=true             # re-check with a fresh Pinnacle price right before each in-play bet (1 credit)

# In-play soccer priced by the bot's own model: Pinnacle's last pre-match price + Betika's live
# score and minute (no delayed live feed, no credits). Same rules as other in-play bets: dry run
# unless LIVE_BETS_LIVE=true. Skips games with a red card, a goal in the last few minutes, or late on.
LIVE_MODEL=true
LIVE_MODEL_MIN_EV=0.06
LIVE_MODEL_MAX_MINUTE=80
LIVE_MODEL_LATE_TEST=true       # after that minute: still priced, but ONLY as dry runs (e.g. 'no more goals' at 90')
LIVE_MODEL_QUIET_MINUTES=3
LIVE_MODEL_MAX_ANCHOR_HOURS=3   # the pre-match price must be from the last 3 h before kick-off

# Basketball 1st half / 1st quarter totals and team totals (NBA, NCAAB, WNBA). Pinnacle's prices
# come from The Odds API per game (1 credit per market with prices), so they are fetched only for
# games Betika lists those markets on, starting within PERIOD_HOURS_BEFORE, each game at most every
# PERIOD_REFRESH_MINUTES, and within PERIOD_DAILY_CREDITS. Settled from Betika's bet history.
PERIOD_MARKETS=true
PERIOD_HOURS_BEFORE=3
PERIOD_REFRESH_MINUTES=20
PERIOD_GAMES_PER_SCAN=3
PERIOD_DAILY_CREDITS=400

# Steam (pre-match): when Pinnacle moves a line by STEAM_MIN_MOVE (3 points of probability) within
# STEAM_WINDOW_MINUTES, re-price that game every STEAM_POLL_SECONDS for STEAM_WATCH_MINUTES to catch
# Betika before it follows; picks Pinnacle is moving AWAY from are not bet until it settles.
STEAM=true
STEAM_MIN_MOVE=0.03
STEAM_WINDOW_MINUTES=15
STEAM_WATCH_MINUTES=10
STEAM_POLL_SECONDS=60
STEAM_MAX_EVENTS=3
STEAM_DAILY_CREDITS=300         # most Odds API credits steam re-pricing may use per day

# ---- OddsPapi (optional second Pinnacle source) ---------------------------
# Free key at https://oddspapi.io (250 requests/month). Used only when The Odds API finds
# fewer than ODDSPAPI_WHEN_FEWER_THAN +EV bets in a full scan. Adds Pinnacle's real alternate
# totals and team totals, and more leagues. 1 request = up to 5 leagues, all markets.
ODDSPAPI_KEY=
ODDSPAPI_WHEN_FEWER_THAN=3
ODDSPAPI_MIN_INTERVAL_MINUTES=180   # 8 uses/day max x 1 request ~ 240/month: fits the free plan
ODDSPAPI_REQUESTS_PER_SCAN=1        # each = up to 5 leagues
ODDSPAPI_SPORTS=basketball,soccer   # which sports OddsPapi picks leagues from, in priority order
# ODDSPAPI_TOURNAMENTS=132,17       # or pick league ids yourself (see `node bin/ev-bot.js oddspapi`)

# ---- Optional alerts --------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
